# Edge
SITE_ADDRESS=metrics.example.com
ACME_EMAIL=ops@example.com

# oauth2-proxy (Google example)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_REDIRECT_URL=https://metrics.example.com/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAINS=.example.com

# Shared secret between Caddy and the Go API. Leave empty to disable the
# header check (the API is still private to the compose network).
# openssl rand -hex 32
PROXY_SHARED_SECRET=

# Empty means every authenticated user is an admin. Set a comma-separated
# allowlist to restrict project creation and threshold edits.
ADMIN_EMAILS=you@example.com

# API tuning
METRICS_WINDOW=60s
WORKER_INTERVAL=5s
SNAPSHOT_RETENTION=168h

# Optional: enables LLM anomaly explanations. Without it the deterministic
# rule-based explanation is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
