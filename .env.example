# Edge
SITE_ADDRESS=metrics.example.com
ACME_EMAIL=ops@example.com

# oauth2-proxy (Google example)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=
# Allowed email domains for login. Required. Specify authorized domain(s) (e.g. example.com).
# Never set to '*' in production.
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_REDIRECT_URL=https://metrics.example.com/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAINS=.example.com

# Shared secret between Caddy and the Go API. Required in production.
# openssl rand -hex 32
PROXY_SHARED_SECRET=

# Comma-separated allowlist of admin emails. Admins create projects, assign
# owners, manage ingest keys, edit thresholds, delete projects, and read the
# audit log. In production, an empty value denies administrative privileges to
# all users (fail-closed), so at least one admin is required before those routes
# work. Existing projects with no owner are admin-only until assigned.
ADMIN_EMAILS=you@example.com

# API tuning
METRICS_WINDOW=60s
WORKER_INTERVAL=5s
SNAPSHOT_RETENTION=168h
# Audit-event retention (90 days default). Older audit rows are pruned hourly.
AUDIT_RETENTION=2160h

# Optional: enables asynchronous Gemini Decisions analysis; key stays server-side.
# Without it incidents retain their deterministic rule-based explanation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-decision-1
# Persistent application-side request cap per UTC day; not a monetary cap.
GEMINI_MAX_DAILY_CALLS=100

# Live-window admission bounds; rejected requests receive HTTP 429.
MAX_PROJECT_RECORDS=50000
MAX_PROJECT_ENDPOINTS=512
MAX_TOTAL_RECORDS=200000
MAX_LIVE_PROJECTS=512
MAX_PROJECT_BYTES=16777216
MAX_TOTAL_BYTES=67108864
INGEST_CONCURRENCY=16
# SQLite main-file page cap and free-space ingest reserve (bytes).
# WAL, backups, temporary files and other disk users are outside the page cap.
SQLITE_MAX_BYTES=2147483648
MIN_FREE_DISK_BYTES=268435456

# Optional --profile ops: Cloudflare R2 backup. Create a private bucket and
# object read/write API token first; never commit the resulting credentials.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=metric/
BACKUP_INTERVAL=1h
BACKUP_TIMEOUT=50m

# Grafana Cloud Prometheus remote-write settings (not the dashboard URL).
# Use a unique deployment name when more than one Metric instance is monitored.
GRAFANA_REMOTE_WRITE_URL=
GRAFANA_REMOTE_WRITE_USER=
GRAFANA_REMOTE_WRITE_PASSWORD=
METRIC_DEPLOYMENT=metric
