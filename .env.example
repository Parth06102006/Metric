# Edge
SITE_ADDRESS=metrics.example.com
ACME_EMAIL=ops@example.com

# oauth2-proxy (Google example)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=
# Allowed email domains for login. Required. Specify authorized domain(s) (e.g. example.com).
# Never set to '*' in production.
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_REDIRECT_URL=https://metrics.example.com/oauth2/callback
OAUTH2_PROXY_WHITELIST_DOMAINS=.example.com

# Shared secret between Caddy and the Go API. Required in production.
# openssl rand -hex 32
PROXY_SHARED_SECRET=

# Comma-separated allowlist of admin emails. Admins create projects, assign
# owners, manage ingest keys, edit thresholds, delete projects, and read the
# audit log. In production, an empty value denies administrative privileges to
# all users (fail-closed), so at least one admin is required before those routes
# work. Existing projects with no owner are admin-only until assigned.
ADMIN_EMAILS=you@example.com

# API tuning
METRICS_WINDOW=60s
WORKER_INTERVAL=5s
SNAPSHOT_RETENTION=168h
# Audit-event retention (90 days default). Older audit rows are pruned hourly.
AUDIT_RETENTION=2160h

# Optional: enables asynchronous Jev incident analysis through OpenRouter.
# Without it incidents retain their deterministic rule-based explanation.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
