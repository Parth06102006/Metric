# syntax=docker/dockerfile:1

FROM oven/bun:1.3.14 AS web

WORKDIR /web

COPY apps/web/package.json apps/web/bun.lock* ./
RUN bun install --frozen-lockfile

COPY apps/web/ ./
RUN bun run build

FROM caddy:2-alpine

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web /web/dist /srv/web

EXPOSE 80 443
