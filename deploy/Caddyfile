{
	{$CADDY_ACME_OPTION}
}

# SITE_ADDRESS is a hostname (metrics.example.com) in production, or :80 for a
# local HTTP-only smoke test. oauth2-proxy needs HTTPS for secure cookies.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' wss://{host}; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Liveness probe. Public so the container healthcheck needs no session.
	handle /health {
		reverse_proxy api:8080
	}

	# Machine ingest. X-API-Key is verified in Go, so SSO must not intercept it.
	handle /ingest/* {
		reverse_proxy api:8080
	}

	# oauth2-proxy owns login, callback, sign-out, and the auth endpoint.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180
	}

	# Live stream. Authenticate every handshake. The Go handler ends streams
	# after five minutes (regardless of pongs), forcing reconnect through this
	# SSO check. Provider revocation visibility still depends on proxy refresh.
	# No buffering on the upgraded connection.
	handle /ws/* {
		route {
			request_header -X-Auth-Request-Email
			request_header -X-Auth-Request-User
			request_header -X-Proxy-Secret
			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				# A client must never be able to assert trusted identity headers.
				# The outer request_header directives strip client identity before
				# the auth check; copy_headers then sets the verified values
				# from the SSO session. If the session yields no identity, the
				# headers stay absent and the Go API fails closed with 401.
				header_up -X-Auth-Request-Email
				header_up -X-Auth-Request-User
				header_up -X-Proxy-Secret
				copy_headers X-Auth-Request-Email X-Auth-Request-User
			}
			reverse_proxy api:8080 {
				header_up Host {host}
				header_up X-Proxy-Secret {$PROXY_SHARED_SECRET}
				flush_interval -1
			}
		}
	}

	# Control plane. Unauthenticated requests receive 401 from oauth2-proxy.
	handle /api/* {
		route {
			request_header -X-Auth-Request-Email
			request_header -X-Auth-Request-User
			request_header -X-Proxy-Secret
			forward_auth oauth2-proxy:4180 {
				uri /oauth2/auth
				# Same spoofing protection as /ws: identity comes only from the
				# verified SSO session, never from the client.
				header_up -X-Auth-Request-Email
				header_up -X-Auth-Request-User
				header_up -X-Proxy-Secret
				copy_headers X-Auth-Request-Email X-Auth-Request-User
			}
			reverse_proxy api:8080 {
				header_up Host {host}
				header_up X-Proxy-Secret {$PROXY_SHARED_SECRET}
			}
		}
	}

	# Built SPA, with client-side routing fallback.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
