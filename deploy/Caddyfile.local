:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle /ingest/* {
		reverse_proxy api:8080
	}

	handle /ws/* {
		reverse_proxy api:8080 {
			header_up Host {host}
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:8080 {
			header_up Host {host}
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
