{
  "__inputs": [{"name":"DS_PROMETHEUS","label":"Grafana Cloud Metrics","type":"datasource","pluginId":"prometheus","pluginName":"Prometheus"}],
  "title": "Metric — disk and backups",
  "tags": ["metric", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from":"now-24h","to":"now"},
  "templating": {"list": [{"name":"deployment","label":"METRIC_DEPLOYMENT","type":"textbox","current":{"text":"metric","value":"metric"},"query":"metric"}]},
  "panels": [
    {"id":1,"title":"Database filesystem available","type":"timeseries","gridPos":{"x":0,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"100 * metric_disk_available_bytes{metric_deployment=\"$deployment\"} / metric_disk_total_bytes{metric_deployment=\"$deployment\"}","legendFormat":"available %"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100},"overrides":[]}},
    {"id":2,"title":"SQLite and WAL size","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"metric_database_bytes{metric_deployment=\"$deployment\"}","legendFormat":"database"},{"refId":"B","expr":"metric_wal_bytes{metric_deployment=\"$deployment\"}","legendFormat":"WAL"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":3,"title":"Time since last verified upload","type":"timeseries","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"(time() - metric_backup_last_success_timestamp_seconds{metric_deployment=\"$deployment\"}) and (metric_backup_last_success_timestamp_seconds{metric_deployment=\"$deployment\"} > 0)","legendFormat":"backup age"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":4,"title":"Backup attempt and exporter health","type":"timeseries","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"metric_backup_last_attempt_success{metric_deployment=\"$deployment\"}","legendFormat":"last backup succeeded"},{"refId":"B","expr":"metric_backup_in_progress{metric_deployment=\"$deployment\"}","legendFormat":"backup running"},{"refId":"C","expr":"up{job=~\"metric-ops|metric-node\",metric_deployment=\"$deployment\"}","legendFormat":"{{job}} up"}],"fieldConfig":{"defaults":{"min":0,"max":1},"overrides":[]}},
    {"id":5,"title":"Time since last successful remote restore check","type":"timeseries","gridPos":{"x":0,"y":16,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"(time() - metric_backup_last_restore_success_timestamp_seconds{metric_deployment=\"$deployment\"}) and (metric_backup_last_restore_success_timestamp_seconds{metric_deployment=\"$deployment\"} > 0)","legendFormat":"restore check age"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":6,"title":"API readiness","type":"stat","gridPos":{"x":12,"y":16,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"metric_api_ready{metric_deployment=\"$deployment\"}"}],"fieldConfig":{"defaults":{"min":0,"max":1},"overrides":[]}},
    {"id":7,"title":"Advisory jobs and daily call reservations","type":"timeseries","gridPos":{"x":0,"y":24,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"targets":[{"refId":"A","expr":"metric_analysis_pending_jobs{metric_deployment=\"$deployment\"}","legendFormat":"queued"},{"refId":"B","expr":"metric_analysis_calls_reserved_today{metric_deployment=\"$deployment\"}","legendFormat":"calls reserved today"}],"fieldConfig":{"defaults":{},"overrides":[]}}
  ]
}
