// All targets are internal Docker services; no metrics ports are published.
prometheus.scrape "metric_ops" {
  targets = [{"__address__" = "metric-ops:9101", "job" = "metric-ops"}]
  forward_to = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "30s"
}

prometheus.scrape "node_exporter" {
  targets = [{"__address__" = "node-exporter:9100", "job" = "metric-node"}]
  forward_to = [prometheus.remote_write.grafana.receiver]
  scrape_interval = "30s"
}

prometheus.remote_write "grafana" {
  external_labels = {"metric_deployment" = sys.env("METRIC_DEPLOYMENT")}
  endpoint {
    url = sys.env("GRAFANA_REMOTE_WRITE_URL")
    basic_auth {
      username = sys.env("GRAFANA_REMOTE_WRITE_USER")
      password = sys.env("GRAFANA_REMOTE_WRITE_PASSWORD")
    }
  }
}
